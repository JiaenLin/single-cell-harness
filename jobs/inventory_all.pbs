#!/bin/bash
#PBS -N sch_inventory_all
#PBS -q workq
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=08:00:00
#PBS -j oe
#
# ============================================================================================
# THE INVENTORY STAGE, FOR EVERY PLUGIN AT ONCE
# ============================================================================================
#
# WHAT IS OWED. Eight of nine plugins owe an accounting of the figures their wrapped tool
# already draws. Not because anyone skipped it - because until recently no command could produce
# the inventory, and it needs the interpreter the PLUGIN runs in, not the harness's. cellchat is
# the one that has been through it: it used 1 of its tool's thirty-odd plots until somebody
# looked, and 32 of 35 afterwards. For seven of the others NOBODY KNOWS THE NUMBER. That is the
# state, not a figure of speech.
#
# WHY ONE JOB. The environment resolver folds nine plugins into three environments, so the whole
# family costs three installs and not nine - and one of those three already exists and will be
# skipped by the content-address check rather than rebuilt. The seven-member environment has
# never been built: 14 pip, 51 conda and 3 R packages, CellChat among them. Whether its declared
# constraints have an installable transitive closure is itself one of the questions here; the
# resolver proves they do not CONTRADICT, and only a real resolve proves they install.
#
# WHAT THIS DOES NOT DO. It does not rule on anything. `account` prints a worksheet with every
# exported plotting function and the evidence beside it; deciding that a wrapper should be using
# the tool's 34th plot, or writing down why it should not, is the judgement stage and belongs to
# a person. The expensive participant should be answering that question rather than finding out
# that the tool has 34 - which is the whole efficiency argument for this pipeline.
#
# --------------------------------------------------------------------------------------------
# THE PREDICTIONS, WRITTEN BEFORE THE RUN.
# --------------------------------------------------------------------------------------------
#
#   Q0  A MANAGER IS ON PATH AT ALL, checked once before anything is attempted. The first run of
#       this job did not check, and reported nine problems that were one missing `module load`.
#
#   Q1  THE EXISTING ENVIRONMENT IS NOT REBUILT. scprofile-env-3e79297712 is on disk at 1.6 GB
#       and its address is derived from the requirements, which have not changed. The install
#       must report it as already present and skip. A rebuild here means the content-address is
#       reading something it should not, and every prose edit in this repository has been
#       silently invalidating environments.
#
#   Q2  THE SEVEN-MEMBER ENVIRONMENT INSTALLS, or the failure names the package pair that
#       stopped it. This has never been built. A resolver conflict is a result; a timeout is not.
#
#   Q3  EVERY PLUGIN GETS AN INVENTORY, or says why not. `NO EXTRACTOR COULD LOOK` is a real
#       answer and names a gap in the extractor layer - it must never be recorded as an empty
#       inventory, which certifies a wrapper as having nothing to account for.
#
#   Q4  THE TWO KNOWN NUMBERS REPRODUCE. cellchat's tool exports 35 plotting functions and
#       velocity's exports 20; both were measured before. A different count means the installed
#       version moved, which is worth knowing and is not a defect in this job.
#
#   Q5  THE SEVEN UNKNOWN NUMBERS BECOME KNOWN. There is no prediction of their size - that is
#       the point of running it - but each must be a number, produced by a named extractor.
#
#   Q6  A MEMBER THAT FAILS DOES NOT SINK THE MEMBER THAT WAS ASKED FOR. Measured on the run
#       before this one: `install liana` ran seven selftests, liana PASSED, and this job recorded
#       INSTALL FAILED - because abundance cannot import statsmodels through pertpy and de and
#       decoupler were SIGKILLed by the node. The tool now records a verdict per member and only
#       the member asked about decides the exit code, so the seal must carry `proofs:` naming
#       each member's verdict, and an environment with a failing member must still let its
#       working members through to the inventory below. The failing ones are refused by name
#       when somebody runs or plans THEM, which is where that refusal belongs.
#
# rule-one: no-removal. Writes inside $RUNDIR, and into $ENVS, which is where this family's
# environments already live and is shared reuse by design - a run that built its own copy would
# defeat the mechanism this job exists to exercise.
# Authored on the workstation and pushed (rule H1). No `git` runs below.
#
#   qsub -v RUNDIR=...,REPO=...,TOOL=...,ENVS=$HOME/envs  jobs/inventory_all.pbs

set -euo pipefail
cd "$PBS_O_WORKDIR"

RUNDIR="${RUNDIR:?pass -v RUNDIR=<run directory>}"
REPO="${REPO:?pass -v REPO=<the harness checkout>}"
TOOL="${TOOL:?pass -v TOOL=<the scProfile checkout>}"
ENVS="${ENVS:?pass -v ENVS=<where this family keeps its environments>}"
HOSTPY="${HOSTPY:-python3}"
# ONLY THESE PLUGINS, WHEN ASKED. The installs below are idempotent and skip on a match, so a
# second submission costs nothing there - but re-inventorying the plugins that already answered
# is work with a known result, and the point of running this at family scale is not to do it
# twice. Space-separated; empty means all of them.
ONLY="${ONLY:-}"

mkdir -p "$RUNDIR/logs" "$RUNDIR/account" "$RUNDIR/inventory"

finish() { s=$?
  set +e
  if [ "$s" -eq 0 ] && [ "${BAD:-0}" -eq 0 ]; then seal="$RUNDIR/SEALED.txt"
  else seal="$RUNDIR/FAILED.txt"; [ "$s" -eq 0 ] && s=1; fi
  { echo "exit=$s"; echo "jobid=${PBS_JOBID:-none}"; echo "host=$(hostname -s)"
    echo "finished=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "purpose=inventory every plugin's wrapped tool, three environments for nine plugins"
    echo "NOT PROMOTABLE. Nothing here is a result about biology; every number counts functions."
    [ "${BAD:-0}" -gt 0 ] && echo "problems=${BAD}"
    # WHICH PLUGIN CAN RUN IN WHICH ENVIRONMENT, from the tool's own per-member records. A
    # shared environment is proved one member at a time, so a seal that carries only this job's
    # own count cannot say which of the seven were proved and which were recorded as failing.
    [ -s "$RUNDIR/logs/proofs.txt" ] && { echo "proofs:"; cat "$RUNDIR/logs/proofs.txt"; }
    [ -s "$RUNDIR/logs/summary.txt" ] && cat "$RUNDIR/logs/summary.txt"
  } > "$seal"
  rm -f "$RUNDIR/RUNNING.txt"
  exit $s; }
trap finish EXIT
{ echo "started=$(date -u +%Y-%m-%dT%H:%M:%SZ)"; echo "host=$(hostname -s)"; } > "$RUNDIR/RUNNING.txt"

# THE PACKAGE MANAGER, BEFORE ANYTHING ELSE. A compute node's PATH is not a login shell's: it
# carries python 3.9 and no conda, so both new environments failed identically nine lines apart
# and the job reported nine problems that were one. The tool's own error named the fix - "on a
# cluster that is usually `module load anaconda3`" - and this job had not read it.
#
# CHECKED ONCE, AT THE TOP, AND REFUSED AS `COULD NOT RUN` RATHER THAN `FAILED`. An environment
# that cannot be attempted is not an environment that will not resolve, and burning a submission
# to discover a missing interpreter nine times is the same waste in a different shape.
if ! command -v conda >/dev/null 2>&1; then
  [ -f /etc/profile.d/modules.sh ] && . /etc/profile.d/modules.sh || true
  module load anaconda3 >/dev/null 2>&1 || true
fi
if ! command -v conda >/dev/null 2>&1 && [ -x /apps/anaconda3/bin/conda ]; then
  export PATH="/apps/anaconda3/bin:$PATH"        # where this cluster keeps it, measured
fi
if ! command -v conda >/dev/null 2>&1; then
  echo "no conda-family manager on PATH after `module load anaconda3` and after trying" >&2
  echo "/apps/anaconda3/bin. Two of the three environments need conda packages - r-base and" >&2
  echo "51 others - so a venv will not do, and nothing below can be attempted." >&2
  exit 3                                          # could not run; not the same as failed
fi
echo "package manager: $(command -v conda)"

export PYTHONNOUSERSITE=1
export XDG_CACHE_HOME="$RUNDIR/cache" MPLCONFIGDIR="$RUNDIR/cache/mpl"
export OMP_NUM_THREADS="${NCPUS:-1}" MKL_NUM_THREADS="${NCPUS:-1}"
BAD=0

echo "=== the plan: which environment each plugin resolves to"
# ASKED OF THE TOOL, NOT WRITTEN HERE. The grouping is the tool's decision and changes when a
# plugin's requirements change; a list in this job would be a second copy of it, stale by design.
( cd "$TOOL" && "$HOSTPY" - ) > "$RUNDIR/logs/groups.tsv" <<'PYG'
import sys
sys.path.insert(0, ".")
from scprofile import resolve as RS
from scprofile.kernels import discover
for g in RS.group_by_compatibility(list(discover().values())):
    for m in g.members:
        print(f"{m}\t{g.name}")
PYG
column -t "$RUNDIR/logs/groups.tsv"

echo; echo "=== build each environment NEEDED, and prove the members asked for; a match is skipped"
# ONLY THE ENVIRONMENTS THE SELECTED PLUGINS RESOLVE TO. Asked for one plugin, this installed
# all three groups and ran seven selftests to inventory one package. Converting a family one
# plugin at a time is the point - a batch pass fits the tool to the whole corpus at once and
# leaves nothing held out to test it against - so the job has to be able to do one.
if [ -n "$ONLY" ]; then
  want_envs=$(for k in $ONLY; do awk -v k="$k" '$1==k{print $2}' "$RUNDIR/logs/groups.tsv"; done \
              | sort -u)
else
  want_envs=$(cut -f2 "$RUNDIR/logs/groups.tsv" | sort -u)
fi
echo "  environments needed: $(echo $want_envs | tr '\n' ' ')"
for env in $want_envs; do
  # AND EVERY MEMBER THAT WAS ASKED FOR, EACH ONE PROVED THROUGH ITSELF. Installing through
  # `abundance` to inventory `liana` makes abundance's failing selftest liana's problem.
  #
  # THIS LINE WAS A NO-OP FOR A MONTH AND THE JOB LOG SAYS SO. It picked the asked-for member,
  # `scprofile install` then looped over every member of the environment regardless, and one
  # failure anywhere raised - so the workaround chose a name and changed nothing. Measured:
  # `install liana` ran seven selftests, liana PASSED, and the job recorded INSTALL FAILED
  # because abundance could not import statsmodels through pertpy and de and decoupler were
  # SIGKILLed by the node.
  #
  # The tool now records a verdict PER MEMBER and only the member that was asked for decides the
  # exit code, so the choice below finally means what it says. `head -1` went with it: with two
  # asked-for plugins in one environment it proved the first and left the second to be
  # inventoried in an environment nothing had run it in.
  members=$(for k in ${ONLY:-}; do awk -v k="$k" -v e="$env" '$1==k && $2==e{print $1}' \
              "$RUNDIR/logs/groups.tsv"; done)
  # NOBODY ASKED, SO ONE MEMBER IS ENOUGH: with no record on disk yet the tool proves every
  # member of the environment on that first install anyway, and records each verdict. Naming all
  # of them here would re-prove the ones it had just recorded - and decoupler's selftest fetches
  # over the network, where a re-prove costs the full 1800s timeout rather than a second.
  [ -n "$members" ] || members=$(awk -v e="$env" '$2==e{print $1; exit}' "$RUNDIR/logs/groups.tsv")
  for member in $members; do
    echo "--- $env  (proving $member)"
    set +e
    ( cd "$TOOL" && "$HOSTPY" -m scprofile.cli install "$member" --prefix "$ENVS" ) \
        > "$RUNDIR/logs/install_${env}_${member}.txt" 2>&1
    rc=$?
    set -e
    if [ "$rc" -ne 0 ]; then
      BAD=$((BAD+1))
      echo "    INSTALL FAILED rc=$rc - see logs/install_${env}_${member}.txt"
      echo "      This is now a fact about $member itself: another member of $env failing is" \
           "recorded against that member and no longer reaches this exit code."
      tail -12 "$RUNDIR/logs/install_${env}_${member}.txt" | sed 's/^/      /'
    else
      echo "    ok  $(grep -ci 'already\|exists\|skip' "$RUNDIR/logs/install_${env}_${member}.txt" \
             || true) reuse line(s)"
    fi
    # WHAT WAS PROVED, PER MEMBER, INTO THE SEAL. The verdicts are the job's other result: which
    # plugins of a shared environment can run there, which cannot, and which were left as they
    # were recorded before. Without this the seal says one number for seven plugins, which is the
    # shape of the defect above wearing a different hat. Its own file, because `summary.txt` is
    # truncated by the inventory stage below and these are written before it.
    sed -n "s/^ *recorded: /  $env  /p" "$RUNDIR/logs/install_${env}_${member}.txt" \
        | tee -a "$RUNDIR/logs/proofs.txt"
  done
done

echo; echo "=== inventory and account, per plugin, in its own interpreter"
: > "$RUNDIR/logs/summary.txt"
# ONE EXTRACTION PER PLUGIN, NOT TWO. This ran `inventory` and then `account`, and `account`
# calls the same extractor itself - so every plugin imported its wrapped tool twice, in its own
# interpreter, to answer one question. `account` prints the count in its first line ("N
# function(s) exported by X. A already decided, B to rule on"), which is what the summary wants
# and is strictly more than the other command was being parsed for.
#
# `inventory` IS THE DIAGNOSTIC, AND IT RUNS ON FAILURE ONLY. Its extra value is per-extractor:
# WHICH one could not look and why. That matters exactly when nothing could, so it is paid for
# then and not on every plugin that worked.
while IFS=$'\t' read -r k env; do
  if [ -n "$ONLY" ] && ! printf '%s\n' $ONLY | grep -qx "$k"; then
    echo "  $k: not asked for this time" >&2
    continue
  fi
  py="$ENVS/$env/bin/python"
  # THE R INTERPRETER TOO, WHERE THE ENVIRONMENT HAS ONE. cellchat wraps an R package and its
  # inventory needs `Rscript`; the first run passed only --python, so the R extractor reported
  # "no Rscript on PATH - a fact about this machine and not about the package", correctly, about
  # a machine whose environment had r-base 4.3 installed in it three lines earlier.
  rs="$ENVS/$env/bin/Rscript"
  rsarg=()
  [ -x "$rs" ] && rsarg=(--rscript "$rs")
  if [ ! -x "$py" ]; then
    echo "  $k: no interpreter at $py - its environment did not build" | tee -a "$RUNDIR/logs/summary.txt"
    BAD=$((BAD+1)); continue
  fi
  set +e
  ( cd "$REPO" && "$HOSTPY" -m sch dev convert account --root "$TOOL" --point kernel \
       --name "$k" --python "$py" "${rsarg[@]}" ) > "$RUNDIR/account/$k.txt" 2>&1
  arc=$?
  set -e
  # `|| true` IS NOT DECORATION HERE. Under `set -euo pipefail` a command substitution whose
  # pipeline fails takes the shell with it, and `grep` fails when it finds nothing - which is
  # precisely the case this line exists to detect. The first plugin whose tool could not be
  # looked at therefore ENDED THE JOB, quietly, after one line of output. The version before
  # this one guarded it with `|| echo 0` and the rewrite dropped the guard along with the
  # command it was attached to.
  line=$(grep -m1 'function(s) exported by' "$RUNDIR/account/$k.txt" 2>/dev/null \
         | sed 's/^ *# *//' || true)
  if [ -n "$line" ]; then
    echo "  $k: $line" | tee -a "$RUNDIR/logs/summary.txt"
  else
    BAD=$((BAD+1))
    echo "  $k: no extractor could look [rc=$arc] - a gap in the extractor layer, NOT an empty" \
        | tee -a "$RUNDIR/logs/summary.txt"
    echo "        inventory, which would certify a wrapper as having nothing to account for" \
        | tee -a "$RUNDIR/logs/summary.txt"
    # THE PER-EXTRACTOR DETAIL, PAID FOR ONLY WHERE IT IS NEEDED: which extractor was asked,
    # and what stopped it.
    ( cd "$REPO" && "$HOSTPY" -m sch dev convert inventory --root "$TOOL" --point kernel \
         --name "$k" --python "$py" "${rsarg[@]}" ) > "$RUNDIR/inventory/$k.txt" 2>&1 || true
    sed -n '1,8p' "$RUNDIR/inventory/$k.txt" | sed 's/^/        /'
  fi
done < "$RUNDIR/logs/groups.tsv"

echo; echo "=== the worksheets are in $RUNDIR/account/ - one per plugin, ready to rule on"
echo "  NOTHING HERE IS A DECISION. Each entry still needs a person to say used, not_applicable,"
echo "  superseded_by_design or duplicate_of, with the evidence the worksheet already carries."
