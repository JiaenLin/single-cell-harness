#!/bin/bash
#PBS -N sch_kernel
#PBS -q workq
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=01:00:00
#PBS -j oe
#
# COPIED FROM the site's serial template (rule zero-B). Kept: set -euo pipefail, cd
# "$PBS_O_WORKDIR", explicit walltime, logs created by the SUBMITTER. Changed: `-o` is passed on
# the qsub line so it lands in <RUNDIR>/logs/ (§3.7), and the seal is an EXIT trap that checks
# products (§3.8g).
#
# THE QUESTION: does the kernel hold on this cluster's interpreter and filesystem, on the toy
# profile (L2), on a synthetic single-cell object, and does `sch conform` read the real tools and
# the real promoted runs without a single site string inside the harness?
#
#   RUNDIR=<project>/runs/single-cell-harness/00_kernel/<UTCSTAMP>__single-cell-harness-<commit>__00_kernel
#   mkdir "$RUNDIR" "$RUNDIR/logs"       # bare mkdir: a run-key collision aborts
#   qsub -v REPO=<tools>/single-cell-harness,PY=<project interpreter>,RUNDIR=$RUNDIR,\
#           TOOLS=<tools dir>,PROJECT=<project>,TERMS=<site terms file> \
#        -o "$RUNDIR/logs/pbs.log" jobs/kernel_suite.pbs
#
# Nothing here names a project, a cohort or a site: every path arrives on the qsub line.
# The prediction, written before the run: every unit test passes, `doctor --architecture`
# holds, and conform reports findings on the four tools that the workstation scan already
# named — a DIFFERENCE from the workstation result is a finding, not noise.

set -euo pipefail
cd "$PBS_O_WORKDIR"

: "${REPO:?pass -v REPO=<harness checkout>}"
: "${PY:?pass -v PY=<interpreter with anndata,h5py,numpy,scipy>}"
: "${RUNDIR:?pass -v RUNDIR=<run directory created by the submitter>}"
: "${TOOLS:=}"
: "${PROJECT:=}"
: "${TERMS:=}"

finish() { s=$?
  set +e
  miss=""
  for w in "$RUNDIR/unit.txt" "$RUNDIR/doctor.json" "$RUNDIR/STATUS.json"; do
    [ -s "$w" ] || miss="$miss ${w#$RUNDIR/}"
  done
  if [ -n "$miss" ] && [ "$s" -eq 0 ]; then s=97; fi
  { echo "exit=$s"; echo "jobid=${PBS_JOBID:-none}"; echo "commit=$(cat "$REPO/HEAD.txt" 2>/dev/null | head -1)"
    hostname; date -u +%Y-%m-%dT%H:%M:%SZ
    echo "products=unit.txt doctor.json conform/*.json STATUS.json"
    [ -n "$miss" ] && echo "missing:$miss"
  } > "$RUNDIR/$([ "$s" -eq 0 ] && echo SEALED.txt || echo FAILED.txt)"
  find "$RUNDIR" -type f -not -path "$RUNDIR/logs/*" -exec chmod a-w {} + 2>/dev/null
  return 0; }
trap finish EXIT

[ -d "$RUNDIR/logs" ] || { echo "$RUNDIR/logs must exist before qsub"; exit 3; }
mkdir -p "$RUNDIR/cache" "$RUNDIR/conform"
export PYTHONNOUSERSITE=1 XDG_CACHE_HOME="$RUNDIR/cache" MPLCONFIGDIR="$RUNDIR/cache/mpl" \
       OMP_NUM_THREADS="${NCPUS:-1}"
echo "${PBS_JOBID:-none}" > "$RUNDIR/PBS_JOBID"
cp "$REPO/HEAD.txt" "$RUNDIR/TOOL_HEAD.txt" 2>/dev/null || echo unknown > "$RUNDIR/TOOL_HEAD.txt"
echo "RUNNING" > "$RUNDIR/RUNNING.txt"
python_status() { "$PY" - "$RUNDIR" "$1" "$2" <<'PY'
import json, sys, time, pathlib
d = pathlib.Path(sys.argv[1]); status, headline = sys.argv[2], sys.argv[3]
p = d / "STATUS.json"
rec = json.loads(p.read_text()) if p.exists() else {"contract": "1.0", "tool": "single-cell-harness",
      "commit": (d / "TOOL_HEAD.txt").read_text().split()[0] if (d / "TOOL_HEAD.txt").exists() else None,
      "started": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
rec.update(status=status, headline=headline, finished=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
p.write_text(json.dumps(rec, indent=1))
PY
}
python_status partial "started"

echo "host      $(hostname)"
echo "python    $("$PY" -c 'import sys; print(sys.version.split()[0])')"
"$PY" -c "import anndata, h5py, numpy, scipy; print('anndata', anndata.__version__, '| h5py', h5py.__version__, '| numpy', numpy.__version__)" || true
echo "commit    $(cat "$RUNDIR/TOOL_HEAD.txt")"
echo

echo "=== 1. unit suite (toy profile, validator regressions, companions, adversarial, single-cell) ==="
( cd "$REPO/tests" && "$PY" -m unittest discover -s . -p 'test_*.py' -v ) > "$RUNDIR/unit.txt" 2>&1 || true
tail -25 "$RUNDIR/unit.txt"

echo; echo "=== 2. doctor --architecture ==="
( cd "$REPO" && "$PY" -m sch --json doctor --architecture ) > "$RUNDIR/doctor.json" || true
( cd "$REPO" && "$PY" -m sch doctor --architecture ) || true

echo; echo "=== 3. plugin test on the shipped single-cell mask (selftest + fixture) ==="
( cd "$REPO" && "$PY" -m sch plugin validate plugins/single-cell/mask_floor plugins/single-cell/probe_differential plugins/single-cell/gate_differential_check ) || true
( cd "$REPO" && "$PY" plugins/single-cell/mask_floor/selftest.py ) || true

if [ -n "$TOOLS" ]; then
  echo; echo "=== 4. conform: the four tools as installed here (static) ==="
  for t in scQC scAnno scIntegrate scProfile; do
    if [ -d "$TOOLS/$t" ]; then
      ( cd "$REPO" && "$PY" -m sch --json conform "$TOOLS/$t" ${TERMS:+--terms "$TERMS"} ) > "$RUNDIR/conform/$t.txt" 2>&1 || true
      head -60 "$RUNDIR/conform/$t.txt"
    fi
  done
fi
if [ -n "$PROJECT" ]; then
  echo; echo "=== 5. conform --run: every promoted run this project names ==="
  for pm in "$PROJECT"/results/*/PROMOTED.md; do
    [ -f "$pm" ] || continue
    # `|| true`, because a PROMOTED.md that names no run key is a document to skip and not a
    # reason to end the job. Under `set -euo pipefail` the failing grep takes the whole shell
    # with it, and the `|| true` on the NEXT line guards a different statement - so one
    # unparseable promotion file silently truncated this suite at section 5.
    rk=$(grep -oE 'runs/[a-z-]+/[0-9]{2}_[a-z_]+/[0-9]{8}T[0-9]{4,6}Z__[^ `|]+' "$pm" \
         | head -1 | tr -d '`' || true)
    [ -n "$rk" ] && [ -d "$PROJECT/$rk" ] && ( cd "$REPO" && "$PY" -m sch conform --run "$PROJECT/$rk" ) 2>&1 | tee -a "$RUNDIR/conform/runs.txt" || true
  done
fi

echo; echo "=== verdict ==="
if grep -q "^OK" "$RUNDIR/unit.txt" && "$PY" -c "import json,sys; sys.exit(0 if all(f['ok'] for f in json.load(open('$RUNDIR/doctor.json'))) else 1)"; then
  python_status ok "unit suite passes and the architecture holds on this cluster"
  echo "KERNEL HOLDS on $(hostname)"
else
  python_status refused "unit suite or doctor failed; read unit.txt and doctor.json"
  echo "KERNEL DOES NOT HOLD; see $RUNDIR/unit.txt"; exit 1
fi
