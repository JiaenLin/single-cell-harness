#!/bin/bash
#PBS -N sambo_04_plan_repro
#PBS -q super
#PBS -l select=1:ncpus=64:mem=360gb
#PBS -l walltime=12:00:00
#PBS -j oe
#
# =============================================================================================
# THE REPRODUCTION: DOES THE PLAN DRAW WHAT THE HAND-WRITTEN SITES DREW, ON THE REAL COHORT
# =============================================================================================
#
# Harness ADR-0016, step 4e. cellchat is on the figure plan: every one of its 47 hand-written
# R draw sites is `.draw("<id>")`, the call and the legend live in `report.figures`, and the
# generated companion draws from it. Nothing about any figure was meant to change. The sealed
# reference is 20260910T130619Z__scprofile-9211f81__04_profile__legends (PBS 710085), drawn by
# the hand-written sites; this run is the same cohort, the same design, the same environment,
# and the plan.
#
# WHY CELLCHAT ALONE. The other eight plugins are HELD OUT - the evidence that the host and the
# maker are general - and are unplugged from this tool tree; the submitter refuses a tree that
# carries more than one kernel.
#
# ---------------------------------------------------------------------------------------------
# THE PREDICTIONS, WRITTEN BEFORE THE RUN. If one of R1-R4 does not hold, the plan changed a
# figure it was not asked to: find the entry, fix the generator or the entry, resubmit. Never a
# "close enough".
# ---------------------------------------------------------------------------------------------
#
#   R0  the run produced panels at all. A grader that passes on no output is the defect this
#       family keeps finding in its own checks.
#   R1  945 PNG and 24 PDF under kernels/, the reference's counts exactly.
#   R2  THE SAME FILES BY NAME: the set of run-relative panel paths (png and pdf) is identical
#       to the reference's, EXCEPT the two per-thousand panels, renamed on purpose from
#       `nativecmp_compareInteractions_<measure>_per1k.png` to
#       `nativecmp_compareInteractions_per1k_<measure>.png` (step 1's second grading found
#       that no family's id prefixed the old name, so every reader of the plan attributed the
#       four compareInteractions files to the raw family and its ceiling of two). Every other
#       per-item family names its files by the entry's own expression, evaluated where the
#       site evaluated it, so no other name can move.
#   R3  90 of 90 numeric per-unit tables identical to the reference (cellchat_net_embedding.csv
#       excluded: an unseeded UMAP, a layout and not a number).
#   R4  chord_cell per contrast [8, 8, 8, 8, 8, 8]: the ceiling is the plan's and the generated
#       draw honours it through the same guard.
#   R5  `capacity --promised` exits 0 with 0 declared-and-never-drawn: every entry of the plan
#       drew at least one file, and nothing on disk is unaccounted for.
#   R6  `capacity --against <reference>` reports no regression.
#   R7  every panel is described: captions.tsv rows equal the reference's (every `.draw` writes
#       a legend from its entry), and no page says NO LEGEND WAS WRITTEN.
#   R8  the environment is REUSED, not rebuilt: `requires` did not change, so the install names
#       the same scprofile-env-<hash> the reference's own install log names. (The first
#       submission predicted a hash copied from an older record; the substance held - both
#       runs used scprofile-env-2d8b9a3b36 - and the number was mine to have read.)
#   R10 the exit standard's `kinds` criterion (ADR-0016 step 6), read from the plan beside this
#       report, names no R-drawn panel: every caption a kind holds to a count states one. The
#       only figures it may name are the two host-drawn plates whose captions are not on the
#       plan yet, F2_population_power and F10_pathway_similarity.
#   R9  the maker's run-side stages answer the same as on the reference: `sch dev convert
#       status --run` exits 0 on both, every stage's verdict is the same on both, and the
#       `audited` line's count of panels drawn and NOT measured by any machine is the same.
#       (`measure` OWES on both: eighteen instances shared one job, so no per-instance memory
#       was fitted - the first submission predicted "answered" and the stage said, correctly,
#       why not. `promised` answers on both once the rank-estimation PDFs count as drawn.)
#
# rule-one: no-removal - everything this writes goes inside $RUNDIR.
# Authored on the workstation and pushed (rule H1). No `git` runs below. Submit with
# jobs/submit_plan_reproduction.sh, never qsub directly: the run key is built there.
# =============================================================================================
set -euo pipefail

HOME_=/data/wangyb/home/jiaen.lin
PROJ="$HOME_/projects/SAMBO"
: "${RUNDIR:?RUNDIR not set - submit with jobs/submit_plan_reproduction.sh, never qsub directly}"
: "${RUNKEY:?RUNKEY not set - submit with jobs/submit_plan_reproduction.sh, never qsub directly}"
: "${REF:?REF not set - the sealed run whose figures this must reproduce}"
HARNESS="${HARNESS:-$HOME_/tools/single-cell-harness}"
[ -d "$RUNDIR/logs" ] || { echo "$RUNDIR/logs does not exist; the submitter creates it"; exit 3; }

finish() {
  s=$?
  miss=""
  for f in report.json RUN_CARD.json report/index.html; do
    [ -s "$RUNDIR/$f" ] || miss="$miss $f"
  done
  [ -n "$(find "$RUNDIR/kernels" -name '*.png' -print -quit 2>/dev/null)" ] || miss="$miss (figures)"
  if [ -n "$miss" ] && [ "$s" -eq 0 ]; then s=97; fi
  {
    echo "exit=$s"
    echo "jobid=${PBS_JOBID:-interactive}"
    echo "runkey=$RUNKEY"
    echo "purpose=does the figure plan draw what the hand-written sites drew (ADR-0016 step 4e)"
    echo "held_out=abundance cellcycle de decoupler liana pseudotime scenic velocity (UNPLUGGED)"
    echo "reproduces=$REF"
    hostname
    date -u +%Y-%m-%dT%H:%M:%SZ
    [ -n "$miss" ] && echo "missing:$miss"
    [ -s "$RUNDIR/PREDICTIONS.txt" ] && cat "$RUNDIR/PREDICTIONS.txt"
  } > "$RUNDIR/$([ "$s" -eq 0 ] && echo SEALED.txt || echo FAILED.txt)"
  find "$RUNDIR" -type f -not -path "$RUNDIR/logs/*" -exec chmod a-w {} + 2>/dev/null || true
}
trap finish EXIT

echo "driver log -> $RUNDIR/logs/driver.log"
exec >> "$RUNDIR/logs/driver.log" 2>&1
echo "=== stage 04_profile - the plan reproduction - $RUNKEY"
echo "=== node $(hostname) - started $(date -u) - PBS ${PBS_JOBID:-interactive}"

TOOL="$HOME_/tools/scProfile-cconly"
H5AD="$PROJ/results/03_integrate/objects/cohort_integrated.h5ad"
DESIGN="$PROJ/stages/04_profile/design.csv"
HOSTENV="$PROJ/env/scprofile-host"
PY="$HOSTENV/bin/python"

[ -x "$PY" ] || { echo "host interpreter missing: $PY"; exit 2; }
for f in "$H5AD" "$DESIGN" "$TOOL/kernels/cellchat.py" "$TOOL/kernels/cellchat.draw.R" \
         "$HARNESS/sch" "$REF/SEALED.txt"; do
  [ -e "$f" ] || { echo "MISSING: $f"; exit 2; }
done

n_kernels=$(find "$TOOL/kernels" -maxdepth 1 -name "*.py" -not -name "_*" | wc -l | tr -d ' ')
echo "=== kernels present in this tool tree: $n_kernels"
if [ "$n_kernels" != "1" ]; then
  echo "REFUSING: this run is the CELLCHAT-ONLY reproduction and the tree carries $n_kernels kernels."
  exit 3
fi

cd "$TOOL"
echo "=== scProfile commit: $(cat HEAD.txt 2>/dev/null || echo unknown)"
echo "=== harness commit: $(cat "$HARNESS/HEAD.txt" 2>/dev/null || echo unknown)"
cp HEAD.txt "$RUNDIR/TOOL_HEAD.txt" 2>/dev/null || true
cp "$HARNESS/HEAD.txt" "$RUNDIR/HARNESS_HEAD.txt" 2>/dev/null || true

set +eu
source /etc/profile 2>/dev/null || true
module load anaconda3/3.0.0 2>/dev/null || true
set -eu
MGR="$(command -v micromamba || command -v mamba || command -v conda || true)"
[ -n "$MGR" ] || { echo "no conda-family manager on PATH after module load"; exit 4; }
echo "=== conda manager: $MGR"
SYSPY="$(command -v python3)"

echo; echo "=== INSTALL (expected: the reference's own environment, reused) ==="
set +e
PYTHONPATH="$TOOL" "$PY" -m scprofile.cli install cellchat --prefix "$PROJ/env" \
    2>&1 | tee "$RUNDIR/logs/install.txt" | tail -25
inst=${PIPESTATUS[0]}
set -e
echo "  install exit: $inst"
if [ "$inst" -ne 0 ]; then
  echo "THE INSTALL FAILED, so nothing below would mean anything. The run is not attempted."
  tail -6 "$RUNDIR/logs/install.txt" | sed "s/^/    /"
  exit 2
fi

echo; echo "=== DOCTOR ==="
set +e
PYTHONPATH="$TOOL" "$PY" -m scprofile.cli doctor --prefix "$PROJ/env" \
    2>&1 | tee "$RUNDIR/logs/doctor.txt" | tail -12
set -e

echo; echo "=== RUN (no reuse, no cache: every instance computed here) ==="
PYTHONPATH="$TOOL" "$PY" -m scprofile.cli run \
    --h5ad "$H5AD" --out "$RUNDIR" --kernel cellchat \
    --prefix "$PROJ/env" --design "$DESIGN" \
    --label-key cell_type_forced --sample-key sample --batch-key batch \
    --counts-layer counts --lognorm-layer lognorm \
    --embedding X_scanvi --layout X_umap_scanvi \
    --organism mouse --assay nucleus --timeout 21600 \
    --control age=young --control diet=chow \
    --no-cache

echo; echo "=== REPORT ==="
PYTHONPATH="$TOOL" "$PY" -m scprofile.cli report --out "$RUNDIR" --prefix "$PROJ/env"

echo; echo "=== STATUS ==="
set +e
PYTHONPATH="$TOOL" "$PY" -m scprofile.cli status --out "$RUNDIR" \
    2>&1 | tee "$RUNDIR/logs/status.txt" | tail -20
set -e

echo; echo "=== CAPACITY: promised, and against the reference ==="
set +e
PYTHONPATH="$TOOL" "$PY" -m scprofile.cli capacity --out "$RUNDIR" --promised \
    > "$RUNDIR/logs/promised.txt" 2>&1
prc=$?
PYTHONPATH="$TOOL" "$PY" -m scprofile.cli capacity --out "$RUNDIR" --against "$REF" \
    > "$RUNDIR/logs/against.txt" 2>&1
arc=$?
# THE EXIT CODES ARE KEPT IN THE FILES THE GRADER READS, never only displayed.
echo "  promised exit: $prc" >> "$RUNDIR/logs/promised.txt"
echo "  against exit: $arc" >> "$RUNDIR/logs/against.txt"
echo "  promised exit: $prc, against exit: $arc"
set -e
tail -6 "$RUNDIR/logs/promised.txt"; tail -8 "$RUNDIR/logs/against.txt"

echo; echo "=== THE EXIT STANDARD, with the plan beside the report ==="
set +e
PYTHONPATH="$TOOL" "$PY" -m scprofile.cli standard --out "$RUNDIR" > "$RUNDIR/logs/standard.txt" 2>&1
stdrc=$?
echo "  standard exit: $stdrc" >> "$RUNDIR/logs/standard.txt"
set -e
grep -n "kinds" "$RUNDIR/logs/standard.txt" | head -12

echo; echo "=== THE MAKER'S RUN-SIDE STAGES, on this run and on the reference ==="
set +e
PYTHONPATH="$HARNESS" "$SYSPY" -m sch dev convert status --root "$TOOL" --point kernel \
    --name cellchat --run "$RUNDIR" > "$RUNDIR/logs/maker_status_new.txt" 2>&1
snc=$?
PYTHONPATH="$HARNESS" "$SYSPY" -m sch dev convert status --root "$TOOL" --point kernel \
    --name cellchat --run "$REF" > "$RUNDIR/logs/maker_status_ref.txt" 2>&1
src=$?
echo "  status(new) exit: $snc" >> "$RUNDIR/logs/maker_status_new.txt"
echo "  status(ref) exit: $src" >> "$RUNDIR/logs/maker_status_ref.txt"
echo "  status exits: new $snc, reference $src"
set -e

echo; echo "=== GRADING THE PREDICTIONS ==="
set +e
SCP_TOOL="$TOOL" PYTHONPATH="$TOOL" "$PY" - "$RUNDIR" "$REF" > "$RUNDIR/PREDICTIONS.txt" 2>&1 <<'PYEOF'
import collections, csv, glob, os, re, sys
new, ref = sys.argv[1], sys.argv[2]
out, bad = [], []
def say(v, name, detail):
    out.append(f"{'PASS' if v else 'FAIL'}  {name}  {detail}")
    if not v: bad.append(name.split()[0])
def rel(d, pattern):
    return sorted(os.path.relpath(p, d) for p in glob.glob(os.path.join(d, "kernels", "**", pattern), recursive=True))
png_n, png_r = rel(new, "*.png"), rel(ref, "*.png")
pdf_n, pdf_r = rel(new, "*.pdf"), rel(ref, "*.pdf")

say(bool(png_n), "R0  the run produced panels at all", f"{len(png_n)} png")
say(len(png_n) == 945 and len(pdf_n) == 24, "R1  945 PNG and 24 PDF, the reference's counts",
    f"{len(png_n)} png, {len(pdf_n)} pdf (reference measured: {len(png_r)} png, {len(pdf_r)} pdf)")
only_new = sorted(set(png_n + pdf_n) - set(png_r + pdf_r))
only_ref = sorted(set(png_r + pdf_r) - set(png_n + pdf_n))
# the one predicted rename: the two per-thousand panels, and nothing else
RENAMED = {"nativecmp_compareInteractions_count_per1k.png": "nativecmp_compareInteractions_per1k_count.png",
           "nativecmp_compareInteractions_weight_per1k.png": "nativecmp_compareInteractions_per1k_weight.png"}
exp_ref = sorted(p for p in png_r if os.path.basename(p) in RENAMED)
exp_new = sorted(os.path.join(os.path.dirname(p), RENAMED[os.path.basename(p)]) for p in exp_ref)
say(only_new == exp_new and only_ref == exp_ref and bool(png_n) and len(exp_ref) == 2,
    "R2  the same files by name, except the two per-thousand panels renamed",
    f"{len(only_new)} only in this run, {len(only_ref)} only in the reference; predicted exactly the "
    f"two renames" + (f"; new: {only_new[:5]}" if only_new != exp_new else "")
    + (f"; missing: {only_ref[:5]}" if only_ref != exp_ref else ""))

def units(d):
    return sorted(os.path.basename(u) for u in glob.glob(os.path.join(d, "kernels", "cellchat", "*")) if os.path.isdir(u))
def rows(p):
    with open(p, newline="", encoding="utf-8", errors="replace") as fh:
        r = list(csv.reader(fh))
    return (r[0] if r else []), sorted(r[1:])
LAYOUT = {"cellchat_net_embedding.csv"}
n_tab, diff = 0, []
for u in sorted(set(units(new)) & set(units(ref))):
    tn = sorted(os.path.basename(p) for p in glob.glob(os.path.join(new, "kernels", "cellchat", u, "tables", "*.csv")))
    tr = sorted(os.path.basename(p) for p in glob.glob(os.path.join(ref, "kernels", "cellchat", u, "tables", "*.csv")))
    for t in sorted(set(tn) & set(tr)):
        if t in LAYOUT: continue
        n_tab += 1
        hn, rn = rows(os.path.join(new, "kernels", "cellchat", u, "tables", t))
        hr, rr = rows(os.path.join(ref, "kernels", "cellchat", u, "tables", t))
        if hn != hr: diff.append(f"{u}/{t} header"); continue
        if rn == rr: continue
        def num(x):
            try: return float(x)
            except ValueError: return x
        a = sorted(tuple(num(v) for v in r) for r in rn)
        b = sorted(tuple(num(v) for v in r) for r in rr)
        same = len(a) == len(b) and all(all((p == q) or (isinstance(p, float) and isinstance(q, float) and abs(p - q) <= 1e-9)
                                              for p, q in zip(x, y)) for x, y in zip(a, b))
        if not same: diff.append(f"{u}/{t}")
say(n_tab == 90 and not diff, "R3  90 of 90 numeric tables identical",
    f"{n_tab - len(diff)} of {n_tab} identical" + (f"; differ: {diff[:6]}" if diff else ""))

ch = collections.Counter()
for f in glob.glob(os.path.join(new, "kernels", "cellchat", "compare", "*", "figures", "nativecmp_chord_cell__*.png")):
    ch[os.path.basename(os.path.dirname(os.path.dirname(f)))] += 1
say(sorted(ch.values()) == [8] * 6, "R4  chord_cell per contrast [8, 8, 8, 8, 8, 8]", f"{sorted(ch.values())}")

def read(p):
    return open(p, encoding="utf-8", errors="replace").read() if os.path.exists(p) else ""
prom = read(os.path.join(new, "logs", "promised.txt"))
gaps = prom.count("        declared to write:")
pexit = re.search(r"promised exit: (\d+)", prom)
say(gaps == 0 and bool(pexit) and pexit.group(1) == "0", "R5  every entry of the plan drew, nothing unaccounted",
    f"{gaps} declared-and-never-drawn; capacity --promised exit {pexit.group(1) if pexit else '?'}")
ag = read(os.path.join(new, "logs", "against.txt"))
say("no regression against" in ag, "R6  no regression against the reference",
    " | ".join(l.strip() for l in ag.splitlines() if "regression" in l.lower())[:200] or "nothing printed")

def cap_rows(d):
    n = 0
    for p in glob.glob(os.path.join(d, "kernels", "**", "captions.tsv"), recursive=True):
        with open(p, encoding="utf-8", errors="replace") as fh:
            n += max(0, sum(1 for _ in fh) - 1)
    return n
cn, cr = cap_rows(new), cap_rows(ref)
noleg = sum(read(p).count("NO LEGEND WAS WRITTEN") for p in glob.glob(os.path.join(new, "report", "**", "*.html"), recursive=True))
say(cn == cr and cn > 0 and noleg == 0, "R7  every panel is described, as in the reference",
    f"{cn} caption rows vs {cr} in the reference; {noleg} panel(s) described by their filename")

ins = read(os.path.join(new, "logs", "install.txt"))
envs = sorted(set(re.findall(r"scprofile-env-[0-9a-f]+", ins)))
renvs = sorted(set(re.findall(r"scprofile-env-[0-9a-f]+", read(os.path.join(ref, "logs", "install.txt")))))
say(bool(envs) and envs == renvs and "exists and matches" in ins,
    "R8  the environment is the reference's, reused",
    f"install names {envs or 'no environment'}; the reference's names {renvs or 'unknown'}")

std = read(os.path.join(new, "logs", "standard.txt"))
kind_fails = [l for l in std.splitlines() if re.match(r"\s+\S+\s+kinds\s", l)]
named = sorted({n for l in kind_fails for n in re.findall(r"([A-Za-z0-9_]+\.png)", l)})
only_host = all(n.startswith(("F2_", "F10_")) for n in named)
say(bool(std) and "kinds" in std and only_host, "R10 the kinds criterion names no R-drawn panel",
    f"{len(kind_fails)} page(s) failing `kinds`; named: {named[:8] or 'none'}"
    + ("" if std else "; standard.txt is empty"))

st_new, st_ref = read(os.path.join(new, "logs", "maker_status_new.txt")), read(os.path.join(new, "logs", "maker_status_ref.txt"))
def verdicts(txt):
    v = {}
    for name in ("measure", "promised", "audited", "looked_at", "written", "delivered"):
        m = re.search(r"^\s*(\S+)\s+" + name + r"\b", txt, re.M)
        v[name] = m.group(1) if m else "?"
    um = re.search(r"(\d+) drawn and NOT measured", txt)
    v["unmeasured"] = um.group(1) if um else "?"
    return v
vn, vr = verdicts(st_new), verdicts(st_ref)
ex = re.search(r"status\(new\) exit: (\d+)", st_new)
say(bool(ex) and ex.group(1) == "0" and vn == vr and "?" not in vn.values()
    and vn.get("promised") == "done",
    "R9  the maker's run-side stages answer as on the reference",
    f"new {vn}; reference {vr}; exit {ex.group(1) if ex else '?'}")

print("\n".join(out))
print()
print(f"VERDICT: {len(out) - len(bad)} of {len(out)} predictions held" + (f"; FAILED: {bad}" if bad else ""))
PYEOF
grade=$?
set -e
cat "$RUNDIR/PREDICTIONS.txt"
if [ "$grade" -ne 0 ]; then
  echo
  echo "THE GRADER ITSELF FAILED (exit $grade). Nothing above is a verdict about the run. Treat"
  echo "  the predictions as UNGRADED."
  exit 2
fi
BAD=$(grep -c '^FAIL' "$RUNDIR/PREDICTIONS.txt" || true)
echo; echo "=== done $(date -u) - run key $RUNKEY - failed predictions: ${BAD:-0}"
