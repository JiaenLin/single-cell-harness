.csv tables/cellchat_ccc_edges__Aging_HFD3.csv tables/cellchat_ccc_edges__HFD.csv tables/cellchat_ccc_edges__Young1.csv tables/cellchat_ccc_edges__Young2.csv tables/cellchat_ccc_edges__Young_HFD1.csv tables/cellchat_ccc_edges__Young_HFD2.csv tables/cellchat_ccc_edges__aged.csv tables/cellchat_ccc_edges__aged_HFD.csv tables/cellchat_ccc_edges__aged_chow.csv tables/cellchat_ccc_edges__chow.csv tables/cellchat_ccc_edges__young.csv tables/cellchat_ccc_edges__young_HFD.csv tables/cellchat_ccc_edges__young_chow.csv tables/cellchat_composition__Aging1.csv tables/cellchat_composition__Aging2.csv tables/cellchat_composition__Aging3.csv tables/cellchat_composition__Aging_HFD1.csv tables/cellchat_composition__Aging_HFD2.csv tables/cellchat_composition__Aging_HFD3.csv tables/cellchat_composition__HFD.csv tables/cellchat_composition__Young1.csv tables/cellchat_composition__Young2.csv tables/cellchat_composition__Young_HFD1.csv tables/cellchat_composition__Young_HFD2.csv tables/cellchat_composition__aged.csv tables/cellchat_composition__aged_HFD.csv tables/cellchat_composition__aged_chow.csv tables/cellchat_composition__chow.csv tables/cellchat_composition__young.csv tables/cellchat_composition__young_HFD.csv tables/cellchat_composition__young_chow.csv; do
    [ -s "$RUNDIR/$p" ] || missing="$missing $p"
  done
  # A SEAL THAT SAYS FAILED MUST EXIT NON-ZERO. Otherwise the scheduler records success while
  # the directory records failure, and whichever one a reader happens to look at is the answer.
  if [ "$s" -eq 0 ] && [ -z "$missing" ]; then
    seal="$RUNDIR/SEALED.txt"
  else
    seal="$RUNDIR/FAILED.txt"
    [ "$s" -eq 0 ] && s=1
  fi
  { echo "exit=$s"
     echo "jobid=${PBS_JOBID:-none}"
     echo "host=$(hostname -s)"
     echo "finished=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
     echo "reference=20260913T042903Z__scprofile-c260046__04_profile__audit"
     echo "tool_commit_expected=$EXPECT_COMMIT"
     echo "tool_commit_actual=${ACTUAL_COMMIT:-unread}"
     [ -n "$missing" ] && echo "missing=$missing"
     echo "products_expected=282"
  } > "$seal"
  rm -f "$RUNDIR/RUNNING.txt"
  exit $s
}
trap 'exit 143' TERM INT HUP   # a killed job seals FAILED, not SEALED (harness ADR-0022)
trap finish EXIT

{ echo "started=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "jobid=${PBS_JOBID:-none}"
  echo "host=$(hostname -s)"
} > "$RUNDIR/RUNNING.txt"

# ---------------------------------------------------------- the checkout has not moved under us
# Read by FILE: compute nodes on this cluster have no git binary. A function with `local`
# declarations rather than a multi-line command substitution - the substitution form tripped
# `set -u` on its own internals, so the guard exited the script before it could compare anything
# and the job sealed on the products alone. A guard that fails open is worse than no guard,
# because the header claims it ran.
read_commit() {
  local gd="$1/.git" head_ ref_
  # A TREE EXPORTED WITHOUT .git CARRIES HEAD.txt - read that first (harness ADR-0019).
  if [ ! -e "$gd" ] && [ -f "$1/HEAD.txt" ]; then cut -d' ' -f1 "$1/HEAD.txt"; return 0; fi
  if [ -f "$gd" ]; then gd="$(sed 's/^gitdir: //' "$gd")"; fi
  head_="$(cat "$gd/HEAD" 2>/dev/null || true)"
  case "$head_" in
    "")    return 1 ;;
    ref:*) ref_="${head_#ref: }"
           if [ -f "$gd/$ref_" ]; then cat "$gd/$ref_"
           else grep " $ref_\$" "$gd/packed-refs" 2>/dev/null | cut -d' ' -f1; fi ;;
    *)     printf '%s' "$head_" ;;
  esac
}
ACTUAL_COMMIT="$(read_commit "$TOOLDIR" || true)"
[ -n "$ACTUAL_COMMIT" ] || { echo "REFUSED: cannot read a commit from $TOOLDIR/.git" >&2; exit 3; }
echo "tool commit: $ACTUAL_COMMIT (expected $EXPECT_COMMIT)"
if [ "$ACTUAL_COMMIT" != "$EXPECT_COMMIT" ]; then
  echo "REFUSED: $TOOLDIR moved between submission and start." >&2
  echo "         expected $EXPECT_COMMIT, found $ACTUAL_COMMIT" >&2
  echo "         A run spanning two versions measures neither. Re-emit the job." >&2
  exit 3
fi

export PYTHONNOUSERSITE=1
# THE CODE THAT RUNS IS THE TREE THAT WAS VERIFIED (harness ADR-0019, blind 0006). The commit
# guard above reads the TREE; the interpreter resolves a module from wherever the package is
# installed - on one cluster, the full checkout beside a one-plugin export, so a nine-plugin
# resolver demanded an environment that did not exist (PBS 711058). The tree goes first on
# PYTHONPATH, and a module command is asked where its package imports from before it runs.
export PYTHONPATH="$TOOLDIR${PYTHONPATH:+:$PYTHONPATH}"
IMPORTED="$(/data/wangyb/home/jiaen.lin/projects/SAMBO/env/scprofile-host/bin/python -c 'import importlib, os, sys; m = importlib.import_module(sys.argv[1]); print(os.path.realpath(os.path.dirname(os.path.dirname(os.path.abspath(m.__file__)))))' scprofile)"
TOOLREAL="$(cd "$TOOLDIR" && pwd -P)"
case "$IMPORTED" in
  "$TOOLREAL"|"$TOOLREAL"/*) echo "tool code: scprofile imports from $IMPORTED" ;;
  *) echo "REFUSED: scprofile imports from $IMPORTED, not from the verified tree $TOOLDIR. The tree was checked and something else would have run." >&2; exit 3 ;;
esac
export XDG_CACHE_HOME="$RUNDIR/cache" MPLCONFIGDIR="$RUNDIR/cache/mpl"
export OMP_NUM_THREADS="${NCPUS:-1}" MKL_NUM_THREADS="${NCPUS:-1}" OPENBLAS_NUM_THREADS="${NCPUS:-1}"
mkdir -p "$RUNDIR/cache"

echo "node: $(hostname -s)  cores: ${NCPUS:-unset}  started: $(date -u)"

# ------------------------------------------------------------------------------- the tool runs
# NOT PIPED, AND NOT TEED. `| tee` and `| tail` return the last command's status, which hid a
# refusal three times in this project; process substitution avoids that but can lose the tail of
# a log at exit. `#PBS -j oe` already captures both streams, so neither is needed here.
# `set -e` is lifted for exactly one line, so the code can be read and reported before the trap
# uses it - under `set -e` the script would leave before `rc` was ever assigned.
set +e
/data/wangyb/home/jiaen.lin/projects/SAMBO/env/scprofile-host/bin/python -m scprofile.cli run --h5ad /data/wangyb/home/jiaen.lin/projects/SAMBO/results/03_integrate/objects/cohort_integrated.h5ad --out /data/wangyb/home/jiaen.lin/projects/SAMBO/runs/scprofile/04_profile/20260915T023343Z__scprofile-a7f247b__04_profile__rerun --kernel cellchat --prefix /data/wangyb/home/jiaen.lin/projects/SAMBO/env --design /data/wangyb/home/jiaen.lin/projects/SAMBO/stages/04_profile/design.csv --label-key cell_type_forced --sample-key sample --batch-key batch --counts-layer counts --lognorm-layer lognorm --embedding X_scanvi --layout X_umap_scanvi --organism mouse --assay nucleus --timeout 21600 --control age=young --control diet=chow --no-cache
rc=$?
set -e
echo "tool exit: $rc"
[ "$rc" -eq 0 ] || exit "$rc"
# ------------------------------------------------------ what the repository says follows a run
# Declared in DEVPOINTS.yaml under `run.after` (harness ADR-0019); each line is one command. Its
# exit code is a VERDICT - `status` owing, `capacity --memory` refusing a declaration - which the
# maker reads from this log; it is not a failure of the run, whose seal reads the products.
/data/wangyb/home/jiaen.lin/projects/SAMBO/env/scprofile-host/bin/python -m scprofile.cli report --out /data/wangyb/home/jiaen.lin/projects/SAMBO/runs/scprofile/04_profile/20260915T023343Z__scprofile-a7f247b__04_profile__rerun && echo "after: exit 0 - '-m scprofile.cli report --out {run}'" || echo "after: exit $? - '-m scprofile.cli report --out {run}'"
