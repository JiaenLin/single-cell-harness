#!/bin/bash
#PBS -N sch_writing_sambo
#PBS -q short
#PBS -l select=1:ncpus=4:mem=32gb
#PBS -l walltime=02:00:00
#PBS -j oe
#
# ============================================================================================
# THE WRITING LAYER'S TEST STAGE, ON THE REAL COHORT
# ============================================================================================
#
# WHY THIS COHORT AND NOT THE FIXTURE. The writing layer's four known defects all live in the
# branch that reads an INTERACTION - a subtraction done the wrong way round that stayed
# self-consistent so no cross-check saw it, marginals emitted before the strata they average, a
# marginal arm that was a question the design enumerated and an object no tool could be handed,
# and a composed section that called five small movers the leading ones. None of those is
# REACHABLE without two crossed factors. The harness fixture has one factor, so every tier there
# is green on a design that cannot express the thing being tested. This cohort is 2x2:
#
#     age x diet, ten libraries      aged/chow 3   aged/HFD 3   young/chow 2   young/HFD 2
#
# and it carries the property that makes the writing matter rather than merely exist: `age` is
# perfectly aliased with `chemistry` (every aged library is GEXSCOPE-V2, every young one V3). An
# age contrast on this cohort is equally a chemistry contrast, and a caption that says "aged
# versus young" and stops is a false sentence about this data. The tool already detects the
# aliasing and states it in the writing brief; what this job asks is whether the statement
# SURVIVES into the page a reader actually meets.
#
# NOTHING IS RE-COMPUTED. The run being read is sealed, exit=0, and is itself a reproduction
# test. Only the documents are rebuilt, from that run's own report.json, which is what
# `scprofile report` is for. The heavy objects are not copied - they are not read by the
# reporter - and the run itself is opened read-only and never written to.
#
# --------------------------------------------------------------------------------------------
# THE PREDICTIONS, WRITTEN BEFORE THE RUN. Measured on the sealed run on 2026-09-09.
# --------------------------------------------------------------------------------------------
#
#   P1  COVERAGE REPRODUCES. 711 panels are on disk and 69 carry a written legend, so 642 do
#       not - 90% of the panels in a finished, sealed, promoted-quality run. A different count
#       means the copy is wrong, not that the writing changed.
#
#   P2  NO CAPTION IS A FILENAME. Not one rendered caption matches the old fallback, which took
#       the file's stem, removed its underscores, and placed the result where a description
#       goes: "interaction flow age response by diet, drawn by the tool itself." A path read as
#       a sentence, with a provenance nothing had checked. Zero occurrences of `, drawn by the
#       tool itself.` and zero of the stem-with-spaces shape.
#
#   P3  AN UNDESCRIBED PANEL SAYS SO. A legend reaches a panel by one of two routes and both
#       count: `captions.tsv` beside the figures, written by a tool drawing in its own
#       interpreter, and `caption=` on `emit_figure`, which arrives in report.json. Every panel
#       with no legend by EITHER route renders a
#       caption containing `NO LEGEND WAS WRITTEN`, and still names its own file so a reader can
#       go and look at it. The count of such captions must EQUAL the count of placed panels with
#       no legend - not merely be non-zero, which a single one would satisfy. Measured: 378 of
#       the 612 placed panels have no legend, and all 180 plugin-drawn ones do have one.
#
#   P4  THE ALIASING SURVIVES TO THE PAGE. `aliased with` appears in the writing brief AND in
#       the rendered report. This is the prediction this cohort exists to test: a 2x2 whose
#       first factor is inseparable from a technical one. If the sentence is in the brief and
#       not on the page, the writing layer knows something the reader is not told.
#
#   P5  THE DESIGN'S OWN QUESTIONS COME OUT RIGHT, computed from the run's own `design` and
#       `controls` in report.json - no design is written into this job. Seven comparisons: four
#       simple, two marginal, one interaction, in that order, because a marginal is an average
#       over strata and means something only after the strata have been seen. The interaction
#       carries a NAME (`age x diet`), and every comparison involving age carries `chemistry` in
#       its `aliased_with`. Both of those were defects found while writing this job and fixed
#       before submitting it: the interaction branch built its entry by hand and omitted the
#       label, and `aliased()` compared the factors only against each other, so naming the two
#       biological factors deleted the warning. Neither is reachable on a one-factor cohort.
#
#   P6  A KNOWN GAP, MEASURED RATHER THAN ASSERTED FIXED. The enumeration above is computed on
#       demand and is NOT persisted: `comparisons` is absent from report.json and all 180
#       figures in the sealed run carry `label: none`. So the design's questions exist in the
#       tool and reach no document. This prediction records that state - 0 labelled figures, no
#       `comparisons` key - so that when it is wired the number moves and says so. A pass here
#       is not good news; it is an accurate account of a gap.
#
# ANY OF THESE FAILING IS A RESULT. P1 and P3 are about a defect that is already known and
# measured; the job exists to state its size on real data and to prove the fallback no longer
# fabricates. P4 and P5 are the ones that could go either way.
#
# rule-one: no-removal. Writes only inside $RUNDIR. $REF is opened read-only.
# Authored on the workstation and pushed (rule H1). No `git` runs below.
#
#   qsub -v RUNDIR=...,REPO=...,TOOL=...,PY=...,REF=...  jobs/writing_sambo.pbs

set -euo pipefail
cd "$PBS_O_WORKDIR"

RUNDIR="${RUNDIR:?pass -v RUNDIR=<run directory>}"
REPO="${REPO:?pass -v REPO=<the harness checkout>}"
TOOL="${TOOL:?pass -v TOOL=<the scProfile checkout>}"
PY="${PY:?pass -v PY=<an interpreter that can import scprofile>}"
REF="${REF:?pass -v REF=<the sealed run to rebuild the documents from>}"

[ -f "$REF/report.json" ] || { echo "REF carries no report.json: $REF"; exit 3; }
[ -f "$REF/SEALED.txt" ] || { echo "REF is not sealed; a document rebuilt from an unsealed run "\
"describes a state nobody chose: $REF"; exit 3; }

mkdir -p "$RUNDIR/logs" "$RUNDIR/replay"

finish() { s=$?
  set +e
  if [ "$s" -eq 0 ] && [ "${BAD:-0}" -eq 0 ]; then seal="$RUNDIR/SEALED.txt"
  else seal="$RUNDIR/FAILED.txt"; [ "$s" -eq 0 ] && s=1; fi
  { echo "exit=$s"; echo "jobid=${PBS_JOBID:-none}"; echo "host=$(hostname -s)"
    echo "finished=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "purpose=test the writing layer on the real 2x2 cohort, documents only"
    echo "ref=$REF"
    echo "NOT PROMOTABLE. No number here is a biological result; every one is about the prose."
    [ "${BAD:-0}" -gt 0 ] && echo "failed_predictions=${BAD}"
    [ -s "$RUNDIR/logs/predictions.txt" ] && cat "$RUNDIR/logs/predictions.txt"
  } > "$seal"
  rm -f "$RUNDIR/RUNNING.txt"
  exit $s; }
trap finish EXIT
{ echo "started=$(date -u +%Y-%m-%dT%H:%M:%SZ)"; echo "host=$(hostname -s)"; } > "$RUNDIR/RUNNING.txt"

export PYTHONNOUSERSITE=1
export XDG_CACHE_HOME="$RUNDIR/cache" MPLCONFIGDIR="$RUNDIR/cache/mpl"

echo "=== copying the documents' inputs, and nothing heavy"
# THE OBJECTS ARE NOT COPIED because the reporter does not read them: it rebuilds from
# report.json and from what is beside the figures. 12.4 GB of h5ad and rds against 0.1 GB of
# panels - copying them would make this job twenty minutes of I/O to change nothing.
#
# AND THE COPY IS WRITABLE. `rsync -a` preserves the mode, a sealed run is `-r--------` by
# design, and the rebuild then died on the first file it tried to replace - after writing some
# of the pages, so the checker read a tree that was half old and half new and reported
# confidently on it. `--no-p` plus an explicit chmod: the source's read-only mode is a property
# of the SEAL and must not be inherited by a scratch copy of it.
rsync -rlt --no-p --chmod=Du+rwx,Fu+rw \
      --exclude 'objects/' --exclude '*.h5ad' --exclude '*.rds' --exclude '*.h5' \
      --exclude 'cache/' --exclude '_cache/' \
      "$REF"/ "$RUNDIR/replay"/ > "$RUNDIR/logs/copy.txt" 2>&1
chmod -R u+rwX "$RUNDIR/replay"
du -sh "$RUNDIR/replay"

echo; echo "=== the state of the copy, before anything is rebuilt"
PANELS=$(find "$RUNDIR/replay/kernels" -name '*.png' | wc -l | tr -d ' ')
LEGENDS=$(find "$RUNDIR/replay/kernels" -name captions.tsv -exec tail -n +2 {} \; | wc -l | tr -d ' ')
echo "  panels on disk     $PANELS"
echo "  written legends    $LEGENDS"

echo; echo "=== rebuilding the documents with the current code"
set +e
( cd "$TOOL" && PYTHONPATH="$TOOL" "$PY" -m scprofile.cli report --out "$RUNDIR/replay" ) \
    > "$RUNDIR/logs/report.txt" 2>&1
rc=$?
set -e
echo "  report rc=$rc"
tail -5 "$RUNDIR/logs/report.txt" || true
# A REBUILD THAT DIED IS NOT A TREE TO PREDICT ABOUT. The first run of this job let rc=1 through
# and the checker then graded a half-rebuilt directory: three predictions were reported against
# pages the current code had never written. Whatever the checker said there was not about the
# writing layer, and it did not look any different from an answer that was.
if [ "$rc" -ne 0 ]; then
  echo "the documents were not rebuilt (rc=$rc); the predictions below would be about the OLD"
  echo "pages copied from the sealed run, which is not what this job asks. Refusing to grade."
  BAD=1
  exit 3
fi

echo; echo "=== the predictions"
set +e
PANELS="$PANELS" LEGENDS="$LEGENDS" TOOL="$TOOL" "$PY" - "$RUNDIR/replay" <<'PYCHK' | tee "$RUNDIR/logs/predictions.txt"
import os, re, sys
from pathlib import Path

run = Path(sys.argv[1])
fails = []


def say(ok, tag, msg):
    print(f"  {'PASS' if ok else 'FAIL'}  {tag}  {msg}")
    if not ok:
        fails.append(tag)


# --- the rendered captions, read out of the tool's own documents. No reshaping: the pages are
#     what a reader opens, and the caption is whatever sits in them.
pages = sorted((run / "report").glob("*.html"))
text = "\n".join(p.read_text(encoding="utf-8", errors="replace") for p in pages)
say(bool(pages), "P0", f"{len(pages)} rendered page(s) to read")

# P1 - coverage reproduces
panels, legends = int(os.environ["PANELS"]), int(os.environ["LEGENDS"])
say(panels == 711 and legends == 69, "P1",
    f"{panels} panels, {legends} written legends, {panels - legends} undescribed "
    f"(predicted 711 / 69 / 642)")

# P2 - no caption is a filename
old_tail = text.count(", drawn by the tool itself.")
# TWO SHAPES, because the fallback had two call sites and the first version of this check only
# knew one. The contrast panels ended `<stem with spaces>, drawn by the tool itself.`; the
# per-unit ones had no comma - `<stem with spaces> Drawn by the tool's own fn().` - so a check
# anchored on the comma passed while the second site was untouched.
stem_shape = len(re.findall(r">\s*(?:\[[^\]]*\]\s*)?[a-z0-9]+(?: [a-z0-9]+){2,}"
                            r"(?:, drawn by | Drawn by the tool)", text))
say(old_tail == 0 and stem_shape == 0, "P2",
    f"{old_tail} caption(s) still end in the old provenance clause, "
    f"{stem_shape} still read as a stem with its underscores removed")

# P3 - an undescribed panel says so, and the count is the count
said = text.count("NO LEGEND WAS WRITTEN")
# every panel the reporter PLACED, and whether a legend existed for it
#
# THERE ARE TWO PLACES A LEGEND CAN COME FROM, and the first version of this check knew one.
# `captions.tsv` is what a tool drawing in its OWN interpreter writes beside its figures; a
# plugin drawing in Python passes `caption=` to `emit_figure` and it arrives in report.json.
# Counting only the first called all 180 plugin-drawn panels undescribed - every one of which
# carries a written sentence - and the run reported 558 undescribed against 378 saying so, a
# discrepancy of exactly the 180. The tool was right and the checker was wrong, and the checker
# was the thing nobody had checked.
import json as _json
_pay = _json.loads((run / "report.json").read_text(encoding="utf-8", errors="replace"))
described = {Path(str(f.get("path") or "")).name
             for v in (_pay.get("kernels") or {}).values()
             for f in (v.get("figures") or [])
             if str(f.get("caption") or "").strip()}
placed, unlegended = 0, 0
for capdir in run.glob("kernels/*/*/figures"):
    have = set(described)
    tsv = capdir / "captions.tsv"
    if tsv.is_file():
        for line in tsv.read_text(encoding="utf-8", errors="replace").splitlines()[1:]:
            have.add(line.split("\t", 1)[0].strip())
    for png in capdir.glob("*.png"):
        if png.name in text or png.stem in text:
            placed += 1
            if png.name not in have:
                unlegended += 1
say(said == unlegended, "P3",
    f"{said} caption(s) say NO LEGEND WAS WRITTEN; {unlegended} placed panel(s) have no legend "
    f"row (of {placed} placed)")

# P4 - the aliasing survives to the page
briefs = list(run.glob("kernels/*/WRITING_BRIEF.md"))
in_brief = sum("aliased with" in b.read_text(encoding="utf-8", errors="replace") for b in briefs)
on_page = text.count("aliased with")
say(in_brief > 0 and on_page > 0, "P4",
    f"`aliased with` in {in_brief}/{len(briefs)} brief(s) and {on_page} time(s) on the pages "
    f"- age is inseparable from chemistry in this cohort")

# P5 - the design's own questions, from the run's own design and controls
import json
pay = json.loads((run / "report.json").read_text(encoding="utf-8", errors="replace"))
design, controls = pay.get("design") or {}, pay.get("controls") or {}
sys.path.insert(0, os.environ.get("TOOL", "."))
try:
    from scprofile.design_panel import comparisons
except Exception as e:                                                    # noqa: BLE001
    say(False, "P5", f"cannot import the enumerator: {e}")
    comparisons = None
if comparisons is not None:
    bio = sorted(controls) or None
    cmps = comparisons(design, factors=bio, controls=controls)
    kinds = [c["kind"] for c in cmps]
    rank = {"simple": 0, "marginal": 1, "interaction": 2}
    seq = [rank[k] for k in kinds]
    inter = [c for c in cmps if c["kind"] == "interaction"]
    named = bool(inter) and bool(inter[0].get("label"))
    alias_ok = all(c.get("aliased_with") for c in cmps
                   if c.get("factor") in {f for f, a in
                                          [(c2.get("factor"), c2.get("aliased_with"))
                                           for c2 in cmps] if a})
    say(len(cmps) == 7 and seq == sorted(seq) and named and alias_ok, "P5",
        f"{len(cmps)} comparison(s) {kinds}; interaction named "
        f"{(inter[0].get('label') if inter else None)!r}; "
        f"aliases {[(c.get('label'), c.get('aliased_with')) for c in cmps if c.get('aliased_with')]}")

# P6 - the gap, measured. A pass here is an accurate account of a gap, not good news.
labelled = sum(1 for v in (pay.get("kernels") or {}).values()
               for f in (v.get("figures") or []) if f.get("label"))
total_figs = sum(len(v.get("figures") or []) for v in (pay.get("kernels") or {}).values())
say(labelled == 0 and "comparisons" not in pay, "P6",
    f"{labelled} of {total_figs} figures carry a contrast label and `comparisons` is "
    f"{'absent' if 'comparisons' not in pay else 'PRESENT'} - the design's questions are "
    f"computed on demand and reach no document")

print(f"\n  {len(fails)} prediction(s) failed" + (f": {', '.join(fails)}" if fails else ""))
sys.exit(1 if fails else 0)
PYCHK
BAD=$?
set -e
echo "  BAD=$BAD"
